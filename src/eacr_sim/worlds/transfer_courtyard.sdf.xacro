<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:arg name="headless" default="true"/>
<world name="default">
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<xacro:unless value="$(arg headless)"><plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/></xacro:unless>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
<light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.8 0.8 0.8 1</specular><direction>-0.5 0.1 -0.9</direction></light>
<model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>.8 .8 .8 1</ambient><diffuse>.8 .8 .8 1</diffuse></material></visual></link></model>

<model name="south_wall"><static>true</static><pose>0 -4 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>8.4 0.2 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>8.4 0.2 0.8</size></box></geometry><material><ambient>0.35 0.45 0.6 1</ambient><diffuse>0.35 0.45 0.6 1</diffuse></material></visual></link></model>
<model name="north_wall"><static>true</static><pose>0 4 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>8.4 0.2 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>8.4 0.2 0.8</size></box></geometry><material><ambient>0.35 0.45 0.6 1</ambient><diffuse>0.35 0.45 0.6 1</diffuse></material></visual></link></model>
<model name="west_wall"><static>true</static><pose>-4 0 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 8.4 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 8.4 0.8</size></box></geometry><material><ambient>0.35 0.45 0.6 1</ambient><diffuse>0.35 0.45 0.6 1</diffuse></material></visual></link></model>
<model name="east_wall"><static>true</static><pose>4 0 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 8.4 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 8.4 0.8</size></box></geometry><material><ambient>0.35 0.45 0.6 1</ambient><diffuse>0.35 0.45 0.6 1</diffuse></material></visual></link></model>
<model name="center_barrier"><static>true</static><pose>0.1 0.1 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.6 1.6 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 1.6 0.8</size></box></geometry><material><ambient>0.35 0.45 0.6 1</ambient><diffuse>0.35 0.45 0.6 1</diffuse></material></visual></link></model>
<model name="southeast_column"><static>true</static><pose>1.8 -1.35 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 0.8 0.8</size></box></geometry><material><ambient>0.35 0.45 0.6 1</ambient><diffuse>0.35 0.45 0.6 1</diffuse></material></visual></link></model>
<model name="northwest_column"><static>true</static><pose>-1.55 1.7 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.75 0.65 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.75 0.65 0.8</size></box></geometry><material><ambient>0.35 0.45 0.6 1</ambient><diffuse>0.35 0.45 0.6 1</diffuse></material></visual></link></model>
</world></sdf>
